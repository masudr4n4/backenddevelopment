# Copy this file to .env and set real values.
# Option A - Local PostgreSQL via Docker: docker compose up -d then use:
#   DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/todoapp
# Option B - Local PostgreSQL installed: DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/your_db_name
# Option C - AWS RDS: use your RDS URL with ?sslmode=require
SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/todoapp